#!/usr/bin/env python3
import os
import sys
import json
import signal
from openai import OpenAI
from rich.console import Console
from rich.panel import Panel
from rich.prompt import Prompt

VERSION = "1.0.0"
console = Console()
CONFIG_FILE = os.path.expanduser("~/.nuca_config.json")

def handle_exit(sig, frame):
    console.print("\n[bold yellow]Keluar dari Nuca (Ctrl+C). Sampai jumpa![/bold yellow]")
    sys.exit(0)

signal.signal(signal.SIGINT, handle_exit)

def load_config():
    cfg = {
        "api_key": "",
        "base_url": "",
        "model": "",
    }
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                cfg.update(json.load(f))
        except Exception:
            pass
    return cfg

def save_config(cfg):
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

def setup_wizard(cfg, force=False):
    if force or not cfg.get("api_key") or not cfg.get("base_url") or not cfg.get("model"):
        console.print(Panel.fit(
            f"[bold cyan]Pengaturan Nuca CLI v{VERSION}[/bold cyan]\n"
            "[white]Silakan masukkan API Key, Base URL, dan Model Anda sendiri:[/white]",
            border_style="cyan"
        ))
        while True:
            val = Prompt.ask("[bold yellow]1. Masukkan API Key Anda[/bold yellow]", default=cfg.get("api_key", "")).strip()
            if val:
                cfg["api_key"] = val
                break
            console.print("[red]API Key wajib diisi![/red]")

        while True:
            val = Prompt.ask("[bold yellow]2. Masukkan Base URL API[/bold yellow]", default=cfg.get("base_url", "")).strip()
            if val:
                cfg["base_url"] = val
                break
            console.print("[red]Base URL wajib diisi![/red]")

        while True:
            val = Prompt.ask("[bold yellow]3. Masukkan Nama Model[/bold yellow]", default=cfg.get("model", "")).strip()
            if val:
                cfg["model"] = val
                break
            console.print("[red]Nama Model wajib diisi![/red]")

        save_config(cfg)
        console.print("[bold green]Pengaturan berhasil disimpan![/bold green]\n")
    return cfg

def create_client(cfg):
    return OpenAI(
        api_key=cfg["api_key"],
        base_url=cfg["base_url"]
    )

def print_banner(cfg):
    console.print(Panel.fit(
        f"[bold cyan]Nuca CLI[/bold cyan] [bold magenta]v{VERSION}[/bold magenta]\n"
        f"[white]Model :[/white] [bold green]{cfg['model']}[/bold green]\n"
        f"[white]URL   :[/white] [bold blue]{cfg['base_url']}[/bold blue]\n"
        f"[white]Key   :[/white] [bold yellow]{cfg['api_key']}[/bold yellow]\n"
        f"[dim]Perintah: /config, /model, /url, /key, /version, /clear | CTRL+C keluar[/dim]",
        border_style="cyan"
    ))

def ask_ai(client, model, messages):
    stream = client.chat.completions.create(
        model=model,
        messages=messages,
        stream=True
    )
    full_reply = ""
    console.print("\n[bold cyan]Nuca:[/bold cyan]")
    for chunk in stream:
        if chunk.choices and chunk.choices.delta.content:
            text = chunk.choices.delta.content
            print(text, end="", flush=True)
            full_reply += text
    print("\n")
    return full_reply

def main():
    if len(sys.argv) > 1 and sys.argv.lower() in ["-v", "--version", "version"]:
        console.print(f"[bold cyan]Nuca CLI[/bold cyan] versi [bold green]v{VERSION}[/bold green]")
        return

    cfg = load_config()
    if len(sys.argv) > 1 and sys.argv.lower() in ["config", "setup", "settings"]:
        setup_wizard(cfg, force=True)
        return

    cfg = setup_wizard(cfg, force=False)
    client = create_client(cfg)

    direct_prompt = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else None
    messages = [
        {
            "role": "system",
            "content": "Anda adalah Nuca, asisten pemrograman AI modern di terminal. Berikan jawaban langsung pada inti kode, bersih, dan efisien."
        }
    ]

    if direct_prompt:
        messages.append({"role": "user", "content": direct_prompt})
        try:
            ask_ai(client, cfg["model"], messages)
        except Exception as e:
            console.print(f"\n[bold red]Error API:[/bold red] {e}")
        return

    print_banner(cfg)

    while True:
        user_input = Prompt.ask("\n[bold green]nuca >[/bold green]")
        if not user_input.strip():
            continue

        if user_input.startswith("/"):
            parts = user_input.split(" ", 1)
            cmd = parts.lower()
            arg = parts.strip() if len(parts) > 1 else ""

            if cmd in ["/config", "/setup", "/settings"]:
                cfg = setup_wizard(cfg, force=True)
                client = create_client(cfg)
                print_banner(cfg)
            elif cmd in ["/version", "/v"]:
                console.print(f"[bold cyan]Nuca CLI[/bold cyan] versi [bold green]v{VERSION}[/bold green]")
            elif cmd == "/clear":
                messages = [messages]
                console.print("[white]Riwayat percakapan dibersihkan.[/white]")
            elif cmd == "/model":
                cfg["model"] = arg if arg else Prompt.ask("Masukkan Nama Model baru", default=cfg["model"]).strip()
                save_config(cfg)
                console.print(f"[green]Model diubah ke: {cfg['model']}[/green]")
            elif cmd == "/key":
                cfg["api_key"] = arg if arg else Prompt.ask("Masukkan API Key baru", default=cfg["api_key"]).strip()
                save_config(cfg)
                client = create_client(cfg)
                console.print("[green]API Key diperbarui![/green]")
            elif cmd == "/url":
                cfg["base_url"] = arg if arg else Prompt.ask("Masukkan Base URL baru", default=cfg["base_url"]).strip()
                save_config(cfg)
                client = create_client(cfg)
                console.print(f"[green]Base URL diubah ke: {cfg['base_url']}[/green]")
            else:
                console.print("[red]Perintah tidak dikenal. Ketik /config untuk mengubah pengaturan.[/red]")
            continue

        messages.append({"role": "user", "content": user_input})

        try:
            reply = ask_ai(client, cfg["model"], messages)
            messages.append({"role": "assistant", "content": reply})
        except Exception as e:
            console.print(f"\n[bold red]Error API:[/bold red] {e}")

if __name__ == "__main__":
    main()
